# Backend
PORT=4000
FACE_SERVICE_URL=http://face-service:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Python face service
# Real command template (edit to your local DeepFaceLive install/model):
DEEPFACELIVE_CMD="python /opt/DeepFaceLive/main.py run --userdata-dir /app/workdir --model /app/models/face.dfm"
# Optional local stub fallback:
# DEEPFACELIVE_CMD="python -m app.deepfacelive_stub"
DEEPFACELIVE_WORKDIR=/app
MODEL_PATH=/app/models
